<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Etap 7, blok G1 (pułapka BQ): cały zestaw działa w JEDNYM procesie PHP,
            a pamięć rośnie z każdym testem. Najcięższe testy (PDF z kodem QR i logo,
            przekodowanie plakatów w GD) mają szczyt ~100 MB. W obrazie Dockera GD jest
            wbudowane w PHP, więc jego obrazy liczą się do memory_limit CLI (128M) —
            przy 344 testach zestaw przekroczył limit. Limit dotyczy tylko testów:
            żądania PHP-FPM mają własne 128M na każde żądanie.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            TESTY CHODZĄ NA PRAWDZIWYM POSTGRESIE, NIE NA SQLITE.

            Domyślne "sqlite / :memory:" jest tu nie do użycia z trzech powodów:
              1. SQLite nie zna CREATE UNIQUE INDEX ... WHERE (indeks częściowy),
                 a to na nim opiera się cała atomowość blokowania miejsc;
              2. SQLite nie zna EXCLUDE USING gist, więc migracja seansów nie przejdzie;
              3. SQLite :memory: to jedno połączenie w jednym procesie — a obowiązkowy
                 test współbieżności uruchamia N osobnych procesów, które muszą
                 widzieć tę samą bazę.

            Osobna baza cinema_testing, bo testy ją czyszczą przy każdym przebiegu;
            wskazanie tu bazy 'cinema' skasowałoby dane deweloperskie.
            DB_HOST, DB_USERNAME i DB_PASSWORD przychodzą z .env — PHPUnit ich nie rusza.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="cinema_testing"/>

        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="TICKET_QR_KEY" value="phpunit-klucz-testowy-podpisu-qr-0123456789abcdef"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
            Etap 8, blok M (pułapka CC): zmiennych, których tu nie ma, PHPUnit nie nadpisuje —
            Laravel bierze je z backend/.env. Po skonfigurowaniu Firebase testy widziały
            PUSH_ENABLED=true i prawdziwą konfigurację web, a kanał push miał pod ręką prawdziwy
            plik konta serwisowego. Testy push włączają go same (config()) z atrapą wysyłki.
        -->
        <env name="PUSH_ENABLED" value="false"/>
        <env name="FCM_PROJECT_ID" value=""/>
        <env name="FCM_CREDENTIALS" value=""/>
        <env name="FIREBASE_WEB_API_KEY" value=""/>
        <env name="FIREBASE_WEB_APP_ID" value=""/>
        <env name="FIREBASE_MESSAGING_SENDER_ID" value=""/>
        <env name="FIREBASE_VAPID_PUBLIC_KEY" value=""/>
    </php>
</phpunit>
