APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=session
REDIS_SESSION_DB=2

BROADCAST_CONNECTION=reverb
# Limit payloadu zdarzenia WebSocket w bajtach; większa zmiana idzie jako seats.resync.
BROADCAST_MAX_PAYLOAD_BYTES=8000
# Bezpiecznik: po nieudanej wysyłce do Reverba wstrzymaj kolejne próby na tyle sekund (0 = wyłączony).
BROADCAST_BREAKER_SECONDS=10
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bilety@cinema.test"
MAIL_FROM_NAME="Kino - bilety"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Ustawienia domenowe kina --------------------------------------------
# Czas życia blokady miejsca w sekundach (domyślnie 10 minut)
SEAT_LOCK_TTL=600
# Maksymalna liczba miejsc, które jedna sesja może trzymać na jednym seansie
SEAT_LOCK_MAX_SEATS=10
# Reklamy i zwiastuny przed filmem (minuty)
SCREENING_ADS_MINUTES=15
# Przerwa na sprzątanie między seansami w tej samej sali (minuty)
SCREENING_CLEANUP_BUFFER=20
# Waluta wszystkich kwot (ISO 4217)
BOOKING_CURRENCY=PLN
# --- Ustawienia domenowe kina --------------------------------------------
# Czas życia blokady miejsca w sekundach (domyślnie 10 minut)
SEAT_LOCK_TTL=600
# Maksymalna liczba miejsc, które jedna sesja może trzymać na jednym seansie
SEAT_LOCK_MAX_SEATS=10
# Reklamy i zwiastuny przed filmem (minuty)
SCREENING_ADS_MINUTES=15
# Przerwa na sprzątanie między seansami w tej samej sali (minuty)
SCREENING_CLEANUP_BUFFER=20
# Waluta wszystkich kwot (ISO 4217)
BOOKING_CURRENCY=PLN
SEAT_LOCK_SWEEP_BATCH=500
SCREENING_CLEANUP_BUFFER_MINUTES=20
# Cache katalogu (repertuar, kina): TTL w sekundach. Zabezpieczenie; inwalidacja idzie przez generacje.
CATALOG_CACHE_TTL=600

# ─── Konto (Etap 8) ──────────────────────────────────────────────────
# Ważność tokenu Sanctum w minutach od wydania (43200 = 30 dni). Po tym czasie API zwraca
# 401 UNAUTHENTICATED, a aplikacja prosi o ponowne logowanie. 0 = bez wygasania (niezalecane).
SANCTUM_EXPIRATION=43200

# ─── Powiadomienia push (Etap 8, blok K) ─────────────────────────────
# Firebase Cloud Messaging HTTP v1. Bez PUSH_ENABLED=true kanał push nie jest używany.
PUSH_ENABLED=false
# Identyfikator projektu Firebase (Ustawienia projektu -> Ogólne). Jawny.
FCM_PROJECT_ID=
# Ścieżka WEWNĄTRZ kontenerów do pliku JSON konta serwisowego Firebase (klucz prywatny — SEKRET).
# Plik kładziemy w docker/secrets/ (katalog ignorowany przez git), montowanym tylko do odczytu jako
# /run/secrets/cinema, np. FCM_CREDENTIALS=/run/secrets/cinema/firebase-service-account.json
FCM_CREDENTIALS=
FCM_TIMEOUT_SECONDS=10
# Konfiguracja aplikacji WEB Firebase (Ustawienia projektu -> Twoje aplikacje) i publiczny klucz VAPID
# (Cloud Messaging -> Certyfikaty Web Push). Wartości jawne, trafiają do przeglądarki (blok L).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_PUBLIC_KEY=
# Aplikacja Android w tym samym projekcie Firebase (Etap 9). Wartości jawne: aplikacja
# mobilna ma je w google-services.json wkompilowanym w APK, a serwer podaje je w
# client-config tylko po to, żeby telefon mógł sprawdzić, czy to TEN SAM projekt.
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=pl.silinski.cinema
PUSH_MAX_DEVICES_PER_USER=20

# ─── Płatności ───────────────────────────────────────────────────────
# Czas (w sekundach) na dokończenie płatności od utworzenia rezerwacji.
# Blokady miejsc rezerwacji dostają ten sam termin.
PAYMENT_WINDOW_SECONDS=600

# Stripe — WYŁĄCZNIE klucze trybu testowego (sandbox).
# Dashboard → Developers → API keys.
# pk_test_... jest publiczny (trafia do Vue i Fluttera).
# sk_test_... jest tajny i nigdy nie opuszcza serwera.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Sekret podpisu webhooka (whsec_...).
# Lokalnie wypisuje go: stripe listen --print-secret
# Na serwerze: Dashboard → Developers → Webhooks → endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=

# Maksymalny wiek zdarzenia webhooka w sekundach (ochrona przed replay).
STRIPE_WEBHOOK_TOLERANCE=300

# Ponowienia SDK przy błędach sieci i limity czasu HTTP (w sekundach).
STRIPE_MAX_NETWORK_RETRIES=2
STRIPE_TIMEOUT_SECONDS=10
STRIPE_CONNECT_TIMEOUT_SECONDS=5

# Bilety (Etap 5): klucz HMAC podpisu kodów QR. Wygeneruj: openssl rand -hex 32
# ZMIANA KLUCZA UNIEWAŻNIA WSZYSTKIE WYDANE KODY QR.
TICKET_QR_KEY=
# Od ilu minut przed seansem obsługa może skanować bilety.
TICKET_VALIDATION_OPENS_MINUTES=60
# Ile minut przed seansem wysyłamy przypomnienie.
SCREENING_REMINDER_MINUTES=120

# Ponawianie zgubionych potwierdzeń zakupu (Etap 5): po ilu minutach od płatności
# i do ilu minut wstecz komenda schedulera wstawia je ponownie do kolejki.
CONFIRMATION_RETRY_AFTER_MINUTES=15
CONFIRMATION_RETRY_WINDOW_MINUTES=120

# --- Reverb / WebSocket (Etap 6) ---
# REVERB_APP_KEY jest jawny: trafia do klienta WebSocket (Vue, Flutter).
# REVERB_APP_SECRET podpisuje autoryzację kanałów i publikację zdarzeń.
# Wygeneruj losowe wartości; sekret nigdy nie trafia do repozytorium.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Adres Reverba widziany z kontenerów PHP (sieć Dockera), NIE z przeglądarki.
# Klient łączy się przez nginx: ws://localhost:8080/app/{REVERB_APP_KEY}.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Na czym nasłuchuje serwer w kontenerze reverb.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Limity czasu publikacji zdarzenia do Reverba, w sekundach.
REVERB_CLIENT_CONNECT_TIMEOUT=0.5
REVERB_CLIENT_TIMEOUT=1.5
