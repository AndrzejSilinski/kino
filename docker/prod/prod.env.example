# Konfiguracja SERWERA (Etap 10, blok F2) — wzór dla docker/prod/prod.env (poza gitem, docker/prod/.gitignore).
# Te same klucze co backend/.env.example (pilnuje tego test dymny bloku F2) z wartościami produkcyjnymi.
# Puste pola MUSZĄ być uzupełnione na serwerze; sekrety (oznaczone [SEKRET]) tylko tam, nigdy w repozytorium.
#
# Generowanie wartości (na serwerze, z katalogu głównego repozytorium):
#   APP_KEY             echo "base64:$(openssl rand -base64 32)"
#   TICKET_QR_KEY       openssl rand -hex 32
#   REVERB_APP_ID       shuf -i 100000-999999 -n 1
#   REVERB_APP_KEY      openssl rand -hex 10        (jawny — trafia do klientów)
#   REVERB_APP_SECRET   openssl rand -hex 20
#   DB_PASSWORD         openssl rand -hex 24
# Stripe: klucze z Dashboard → Developers (w PROD tryb live tylko świadomie), webhook → STRIPE_WEBHOOK_SECRET.
# Firebase: plik konta serwisowego w docker/prod/secrets/ (grupa 82, chmod 640), reszta jak w README, Etap 8.

# --- Zmienne Compose (docker/prod/compose.yml); CINEMA_TAG ustawia tools/deploy/deploy.sh ---
CINEMA_PROJECT=kino
CINEMA_HTTP_PORT=80
CINEMA_HTTPS_PORT=443

# --- Aplikacja (klucze z backend/.env.example) ---
APP_NAME=Kino
APP_ENV=production
# [SEKRET] APP_KEY
APP_KEY=
APP_DEBUG=false
APP_URL=https://kino.example.com
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cinema
DB_USERNAME=cinema
# [SEKRET] DB_PASSWORD
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_CONNECTION=session
REDIS_SESSION_DB=2
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90
BROADCAST_CONNECTION=reverb
BROADCAST_MAX_PAYLOAD_BYTES=8000
BROADCAST_BREAKER_SECONDS=10
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
# [SEKRET] MAIL_PASSWORD
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bilety@kino.example.com"
MAIL_FROM_NAME="Kino - bilety"
SEAT_LOCK_TTL=600
SEAT_LOCK_MAX_SEATS=10
SEAT_LOCK_SWEEP_BATCH=500
SCREENING_ADS_MINUTES=15
SCREENING_CLEANUP_BUFFER_MINUTES=20
BOOKING_CURRENCY=PLN
CATALOG_CACHE_TTL=600
SANCTUM_EXPIRATION=43200
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS=/run/secrets/cinema/firebase-service-account.json
FCM_TIMEOUT_SECONDS=10
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_PUBLIC_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=pl.silinski.cinema
PUSH_MAX_DEVICES_PER_USER=20
PAYMENT_WINDOW_SECONDS=600
STRIPE_PUBLISHABLE_KEY=
# [SEKRET] STRIPE_SECRET_KEY
STRIPE_SECRET_KEY=
# [SEKRET] STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_MAX_NETWORK_RETRIES=2
STRIPE_TIMEOUT_SECONDS=10
STRIPE_CONNECT_TIMEOUT_SECONDS=5
# [SEKRET] TICKET_QR_KEY
TICKET_QR_KEY=
TICKET_VALIDATION_OPENS_MINUTES=60
SCREENING_REMINDER_MINUTES=120
CONFIRMATION_RETRY_AFTER_MINUTES=15
CONFIRMATION_RETRY_WINDOW_MINUTES=120
REVERB_APP_ID=
REVERB_APP_KEY=
# [SEKRET] REVERB_APP_SECRET
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_CLIENT_CONNECT_TIMEOUT=0.5
REVERB_CLIENT_TIMEOUT=1.5
