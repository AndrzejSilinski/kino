<!--
  Ikona powiadomienia (Etap 9, blok M3, decyzja 360).

  Android od wersji 5 traktuje małą ikonę powiadomienia jako MASKĘ: bierze
  z niej wyłącznie kształt i maluje go jednym kolorem. Ikona aplikacji, użyta
  w tym miejscu, zamienia się więc w białą plamę — dlatego osobny rysunek:
  biała sylwetka na przezroczystym tle, bez półcieni i bez koloru.

  Kształt to bilet: zaokrąglony prostokąt z trzema wyciętymi liniami.
  Wycięcia robi `fillType="evenOdd"` (dostępne od API 24; aplikacja wymaga 24).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4,4 h16 a2,2 0 0 1 2,2 v12 a2,2 0 0 1 -2,2 h-16 a2,2 0 0 1 -2,-2 v-12 a2,2 0 0 1 2,-2 z M6,8.4 h12 v1.8 h-12 z M6,12.1 h12 v1.8 h-12 z M6,15.8 h7.5 v1.8 h-7.5 z" />
</vector>
